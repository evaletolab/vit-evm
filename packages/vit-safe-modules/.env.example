# Copier en .env (ignoré par git) avant tout déploiement.

# Clé du compte qui paie le gas ET devient owner du proxy UUPS
# (seul autorisé à signer les futurs upgrades). Garder cette clé.
PRIVATE_KEY=0x

# Optionnels : par défaut RPC publics (PublicNode / sepolia.optimism.io)
SEPOLIA_RPC_URL=
OP_SEPOLIA_RPC_URL=
