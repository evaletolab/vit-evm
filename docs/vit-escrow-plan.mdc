## 🏗️ Spécifications Techniques

### États Escrow Unifiés

```solidity
enum EscrowStatus {
    CREATED,        // Escrow créé, en attente de funding
    FUNDED,         // Fonds déposés
    STAKED,         // Stake payee déposé (si requis)
    PENDING_CLAIM,  // Claim link en attente
    CLAIMED,        // Claim link réclamé
    RELEASED,       // Fonds libérés au payee
    DISPUTED,       // Dispute ouverte
    RESOLVED,       // Dispute résolue
    CANCELLED,      // Annulé par sender
    EXPIRED,        // Timeout expiré
    REFUNDED        // Remboursé au payer
}
```

### Transitions d'État

```
CREATED ──[fund()]──► FUNDED
    │                    │
    │                    ├──[stake()]──► STAKED
    │                    │                  │
    │                    │                  ├──[release()]──► RELEASED
    │                    │                  │
    │                    │                  ├──[dispute()]──► DISPUTED
    │                    │                  │                    │
    │                    │                  │                    └──[resolve()]──► RESOLVED
    │                    │                  │
    │                    │                  └──[timeout]──► EXPIRED ──► REFUNDED
    │                    │
    │                    ├──[createClaim()]──► PENDING_CLAIM
    │                    │                         │
    │                    │                         ├──[claim()]──► CLAIMED
    │                    │                         │
    │                    │                         └──[timeout/cancel]──► CANCELLED
    │                    │
    │                    └──[cancel()]──► CANCELLED ──► REFUNDED
    │
    └──[timeout]──► EXPIRED
```

### Interface Commune

```solidity
interface IVitEscrow {
    // Core
    function createEscrow(
        address payee,
        uint256 amount,
        uint256 expiresAt,
        EscrowType escrowType,
        bytes calldata params
    ) external payable returns (uint256 escrowId);
    
    function fund(uint256 escrowId) external payable;
    function cancel(uint256 escrowId) external;
    function release(uint256 escrowId) external;
    
    // Claim Link specific
    function createClaimLink(
        uint256 amount,
        uint256 expiresAt,
        bytes32 secretHash
    ) external payable returns (uint256 claimId);
    
    function claim(
        uint256 claimId,
        bytes32 secret,
        address recipient
    ) external;
    
    // Dispute specific
    function stake(uint256 escrowId, uint256 amount) external;
    function openDispute(uint256 escrowId, bytes32 evidenceHash) external;
    function resolveDispute(uint256 escrowId, Verdict verdict) external;
    
    // Views
    function getEscrow(uint256 escrowId) external view returns (Escrow memory);
    function getStatus(uint256 escrowId) external view returns (EscrowStatus);
}
```

### Structures de Données

```solidity
struct Escrow {
    address payer;
    address payee;
    uint256 amount;
    uint256 stakeAmount;
    uint256 createdAt;
    uint256 expiresAt;
    EscrowStatus status;
    EscrowType escrowType;
    bytes32 secretHash;     // Pour claim links
    bytes32 evidenceHash;   // Pour disputes
    bytes params;           // Paramètres additionnels
}

enum EscrowType {
    SIMPLE,         // Release directe
    CLAIM_LINK,     // Secret-based claim
    DISPUTE,        // Avec stake et dispute possible
    PRE_AUTH,       // Capture différée
    CONDITIONAL     // Multi-conditions
}

enum Verdict {
    PENDING,
    PAYER_WINS,
    PAYEE_WINS,
    SPLIT
}
```

